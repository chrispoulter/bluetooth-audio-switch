<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Authors>Chris Poulter</Authors>
    <Product>Bluetooth Audio Switch</Product>
    <Copyright>Copyright (c) 2026 Chris Poulter</Copyright>
    <AssemblyName>btaudio</AssemblyName>
    <RootNamespace>BluetoothAudioSwitch</RootNamespace>
    <Description>Connect and disconnect paired Bluetooth audio devices from the command line.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>Icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="Icons\*.ico"
      Exclude="Icons\app.ico"
      LogicalName="Icons.%(Filename)%(Extension)"
    />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BluetoothAudioSwitch.Tests" />
  </ItemGroup>
</Project>
